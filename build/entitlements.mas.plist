<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Required for Mac App Store distribution. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- V8 requires JIT support. Electron's default MAS entitlements include this. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Sign-in, DRM activation, and document API calls to server.confishare.io. -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Imports are read from files explicitly chosen by the user in the file picker. -->
    <key>com.apple.security.files.user-selected.read-only</key>
    <true/>
  </dict>
</plist>
